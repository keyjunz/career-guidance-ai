APP_NAME=career-guidance-ai
APP_ENV=dev
APP_PORT=8010
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_guidance

GEMINI_API_KEY=your_gemini_api_key
GEMINI_AGENT_API_KEY=your_gemini_agent_key
GEMINI_OCR_API_KEY=your_gemini_ocr_key
GEMINI_IMAGE_CAPTION_API_KEY=your_gemini_image_caption_key
GEMINI_MODEL_NAME=gemini-2.0-flash

# Semantic Chunking Configuration
SEMANTIC_CHUNK_SIZE=512
SEMANTIC_CHUNK_OVERLAP=100
SEMANTIC_SIMILARITY_THRESHOLD=0.5
MAX_CHUNK_SIZE=1024
# GROQ API for Llama/Mixtral (Fast inference for RAG generation)
GROQ_API_KEY=your_groq_api_key

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=career_guidance_chunks

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=career_guidance_documents
CHROMA_PERSIST_DIR=./chroma_data

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0

FIRECRAWL_API_KEY=your_firecrawl_api_key
# WEB_SEARCH_API_KEY is also supported as an alias for FIRECRAWL_API_KEY.

# OCR (Paddle) + image serving
PADDLE_LAYOUT_MODEL_DIR=src/model_ml/PP-DocLayout_plus-L_infer
PADDLE_REC_MODEL_DIR=src/model_ml/PP-OCRv5_server_rec_infer
PADDLE_USE_GPU=false
PDF_RENDER_ZOOM=1.5
LAYOUT_SCORE_THRESHOLD=0.5
IMAGE_STORAGE_DIR=database/images
IMAGE_BASE_URL=http://localhost:8010

# OCR (Gemini)
GEMINI_OCR_MAX_PAGES=0
GEMINI_OCR_TIMEOUT=120

# Multi-intent decomposition (LLM) + hybrid retrieval result cache
AGENT_MULTI_INTENT=true
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SEC=3600
RETRIEVAL_CACHE_MAX_ENTRIES=100
